{
  "name": "orire",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "postinstall": "prisma generate",
    "db:up": "sh scripts/db-up.sh",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "dev:login": "open http://localhost:3001/api/dev/login",
    "stripe:verify": "node --env-file=.env scripts/verify-stripe.mjs",
    "stripe:prices": "node --env-file=.env scripts/create-stripe-prices.mjs",
    "stripe:webhook": "node --env-file=.env scripts/verify-webhook.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "^6.19.3",
    "@stripe/react-stripe-js": "^7.0.0",
    "@stripe/stripe-js": "^10.0.0",
    "framer-motion": "^13.4.6",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "mammoth": "^1.13.0",
    "next": "16.3.7",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^8.0.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "^17.7.0",
    "unpdf": "^1.8.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^2.1.9"
