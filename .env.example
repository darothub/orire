# Copy to .env and fill in, THEN start the app (env is read once at boot):
#   cp .env.example .env
#   npx auth secret            # writes a real AUTH_SECRET (or: openssl rand -base64 33)
#   npm run db:up              # Dockerised Postgres on localhost:5433 (postgres:16)
#   npx prisma migrate deploy  # apply the schema to a fresh database
#   PORT=3001 npm run dev
# Missing/placeholder AUTH_SECRET -> "MissingSecret: Please define a secret";
# DB not up/migrated -> PrismaClientInitializationError.
DATABASE_URL="postgresql://orire:orire@localhost:5433/orire?schema=public"

# Auth.js — generate a secret with: npx auth secret  (or openssl rand -base64 33)
AUTH_SECRET="replace-me"
AUTH_TRUST_HOST=true

# Optional: real email sending for magic links (dev prints the link to the terminal).
# EMAIL_SERVER="smtp://user:pass@smtp.example.com:587"
# EMAIL_FROM="orire <no-reply@yourdomain.com>"

# Optional OAuth — enable a provider by supplying its id/secret.
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Managed AI keys (fully-managed model, item #1). orire holds these server-side
# and runs every user's inference on them — users never paste their own key.
# Without a key, the matching provider's /api/ai/* routes return a clear
# "not configured" error (verbatim to the user). Supply at least one.
#   OpenAI:    https://platform.openai.com/api-keys
#   Anthropic: https://console.anthropic.com/settings/keys
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Stripe (Phase B2 — billing). Optional: without STRIPE_SECRET_KEY the plan
# panel falls back to the local dev plan switch. Price ids come from your
# Stripe dashboard (test mode is fine). The webhook secret is printed by
# `stripe listen --forward-to localhost:3001/api/billing/webhook`.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_CAREER=price_...
# Public key — enables the embedded, orire-branded checkout form. Without it
# the app falls back to Stripe's hosted Checkout page (a redirect).
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Optional: override the origin used for Checkout success/cancel URLs.
# APP_URL=http://localhost:3001

# Captcha (item #6 — Cloudflare Turnstile). Optional: without a secret key the
# magic-link form skips the challenge (dev). Create a free widget at
# https://dash.cloudflare.com/?to=/:account/turnstile and paste both keys.
# The site key is public (inlined in the client); the secret stays server-side.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
# TURNSTILE_SECRET_KEY=0x4AAAAAAA...

# Dev full-access login (local only). In any non-production build you get a
# "⚡ Dev login" button in the app bar and a GET /api/dev/login route that signs
# you in as a top-tier (career) account with every plan gate unlocked — no email,
# no Stripe. The route 404s in production. Set ORIRE_DEV_LOGIN=0 to disable it.
# Note: unlocking plan gates does NOT fake provider calls — real AI inference
# still needs a genuine managed API key (OPENAI_API_KEY / ANTHROPIC_API_KEY).
# ORIRE_DEV_LOGIN=0
# ORIRE_DEV_EMAIL=dev@orire.local
