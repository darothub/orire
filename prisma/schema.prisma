// orire data model — Auth.js identity tables + product domain (CVs, refine
// history, subscription entitlement, monthly usage). Postgres in dev/prod.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Auth.js (next-auth) adapter models ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  /// The library version currently open in the editor (autosave target).
  activeDocumentId String?

  accounts    Account[]
  sessions    Session[]
  documents   Document[]
  refineRuns  RefineRun[]
  exportEvents ExportEvent[]
  entitlement Entitlement?
  usage       UsageCounter[]
  consumedRefineRuns ConsumedRefineRun[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Single-use, hashed tokens for the "forgot password" flow. The raw token is
// emailed to the user; only its SHA-256 hash is stored here.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Single-use, hashed tokens for email-address verification. Mirrors the reset
// flow: the raw token is emailed; only its SHA-256 hash is stored here.
model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Product domain ----------

/// A saved CV document. A user may keep several; the client tracks the active one.
model Document {
  id             String    @id @default(cuid())
  userId         String
  title          String    @default("Untitled CV")
  /// Company/role this version targets — the library grouping key.
  company        String?
  template       String    @default("aurora")
  data           Json
  baseline       Json?
  /// Last time this exact version was exported (PDF/Word), if ever.
  lastExportedAt DateTime?
  /// Opt-in public share: a random, revocable token. When set, the CV is
  /// readable at /cv/<shareToken> by anyone with the link; null = private.
  shareToken     String?   @unique
  sharedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// History of AI refine/compare runs, kept per user (req: company history / audit).
model RefineRun {
  id             String   @id @default(cuid())
  userId         String
  documentId     String?
  company        String?
  jobDescription String   @db.Text
  provider       String
  model          String?
  resultData     Json
  ratingBefore   Int?
  ratingAfter    Int?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// One row per successful CV export (PDF). Drives the profile "exports" stat
/// so the count survives across devices (History is client-only).
model ExportEvent {
  id        String   @id @default(cuid())
  userId    String
  format    String   @default("pdf")
  template  String?
  company   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Subscription entitlement, synced from Stripe in B2. Source of truth for the plan gate.
model Entitlement {
  id                   String    @id @default(cuid())
  userId               String    @unique
  plan                 String    @default("free")
  status               String?
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  currentPeriodEnd     DateTime?
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Server-authoritative usage counter — the enforceable version of planStore
/// usage. One row per (user, metric, period):
///   - metric: "refine" | "simulate" | "download"
///   - period: "lifetime" (never-resetting caps, e.g. Free) or "YYYY-MM"
///             (monthly caps, e.g. Pro refine)
/// Counts are monotonic and survive CV deletion / cache clears because the row
/// is keyed by user, not by any document (req: limits must not reset).
model UsageCounter {
  id     String @id @default(cuid())
  userId String
  metric String
  period String
  count  Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, metric, period])
  @@index([userId])
}

/// Idempotency ledger for refine consumption. A run's credit is consumed by the
/// FIRST successful provider call that claims the run id here, so a two-column
/// compare costs exactly one refine and a fully-failed run (AI error) costs
/// nothing — "only successful actions decrement". Keyed by the run nonce in the
/// signed run token.
model ConsumedRefineRun {
  runId     String   @id
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Idempotency ledger for Stripe webhooks. Stripe delivers events at-least-once,
/// so a handler can be invoked repeatedly (and concurrently) for the same event.
/// The webhook claims each event id here before handling; a duplicate claim is
/// skipped and acked. A failed handler releases its claim so Stripe's retry can
/// reprocess the event later.
model ProcessedWebhookEvent {
  id          String   @id // Stripe event id, e.g. "evt_..."
  type        String
  processedAt DateTime @default(now())
}
