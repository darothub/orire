// orire data model — Auth.js identity tables + product domain (CVs, refine
// history, subscription entitlement, monthly usage). Postgres in dev/prod.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Auth.js (next-auth) adapter models ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  /// The library version currently open in the editor (autosave target).
  activeDocumentId String?
  /// Tailor fact ledger: what the candidate told us, reused across tools.
  factLedger Json?

  accounts    Account[]
  sessions    Session[]
  documents   Document[]
  refineRuns  RefineRun[]
  exportEvents ExportEvent[]
  entitlement Entitlement?
  usage       UsageCounter[]
  consumedRefineRuns ConsumedRefineRun[]
  occCareerProfile OccCareerProfile?
  occAdviceRuns OccAdviceRun[]
  occCvVersions OccCvVersion[]
  lifecycleEmails LifecycleEmail[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Single-use, hashed tokens for the "forgot password" flow. The raw token is
// emailed to the user; only its SHA-256 hash is stored here.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Single-use, hashed tokens for email-address verification. Mirrors the reset
// flow: the raw token is emailed; only its SHA-256 hash is stored here.
model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Single-use, hashed tokens for passwordless sign-in links. Keyed by email so
// the first link can also create the account; only the SHA-256 hash is stored.
model MagicLinkToken {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

// ---------- Product domain ----------

/// A saved CV document. A user may keep several; the client tracks the active one.
model Document {
  id             String    @id @default(cuid())
  userId         String
  title          String    @default("Untitled CV")
  /// Company/role this version targets — the library grouping key.
  company        String?
  template       String    @default("aurora")
  data           Json
  baseline       Json?
  /// Last time this exact version was exported (PDF/Word), if ever.
  lastExportedAt DateTime?
  /// Opt-in public share: a random, revocable token. When set, the CV is
  /// readable at /cv/<shareToken> by anyone with the link; null = private.
  shareToken     String?   @unique
  sharedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  occRevision OccCvVersion?

  @@index([userId])
}

/// History of AI refine/compare runs, kept per user (req: company history / audit).
model RefineRun {
  id             String   @id @default(cuid())
  userId         String
  documentId     String?
  company        String?
  jobDescription String   @db.Text
  provider       String
  model          String?
  resultData     Json
  ratingBefore   Int?
  ratingAfter    Int?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// One row per successful CV export (PDF). Drives the profile "exports" stat
/// so the count survives across devices (History is client-only).
model ExportEvent {
  id        String   @id @default(cuid())
  userId    String
  format    String   @default("pdf")
  template  String?
  company   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Subscription entitlement, synced from Stripe in B2. Source of truth for the plan gate.
model Entitlement {
  id                   String    @id @default(cuid())
  userId               String    @unique
  plan                 String    @default("free")
  status               String?
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  currentPeriodEnd     DateTime?
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Server-authoritative usage counter — the enforceable version of planStore
/// usage. One row per (user, metric, period):
///   - metric: "refine" | "simulate" | "download"
///   - period: "lifetime" (never-resetting caps, e.g. Free) or "YYYY-MM"
///             (monthly caps, e.g. Pro refine)
/// Counts are monotonic and survive CV deletion / cache clears because the row
/// is keyed by user, not by any document (req: limits must not reset).
model UsageCounter {
  id     String @id @default(cuid())
  userId String
  metric String
  period String
  count  Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, metric, period])
  @@index([userId])
}

/// Idempotency ledger for refine consumption. A run's credit is consumed by the
/// FIRST successful provider call that claims the run id here, so a two-column
/// compare costs exactly one refine and a fully-failed run (AI error) costs
/// nothing — "only successful actions decrement". Keyed by the run nonce in the
/// signed run token.
model ConsumedRefineRun {
  runId     String   @id
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Idempotency ledger for lifecycle/activation nudge emails (P1-12), so the
/// cron sweep that sends them never double-sends. One row per (user, kind) —
/// `kind` identifies which nudge, e.g. "activation_24h". The sweep's own
/// signals for "has this user activated" are read from existing tables
/// (ExportEvent, UsageCounter) rather than duplicated here; this table exists
/// only because nothing else tracks "have we already emailed this user about
/// this".
model LifecycleEmail {
  id     String   @id @default(cuid())
  userId String
  kind   String
  sentAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
  @@index([userId])
}

/// Idempotency ledger for Stripe webhooks. Stripe delivers events at-least-once,
/// so a handler can be invoked repeatedly (and concurrently) for the same event.
/// The webhook claims each event id here before handling; a duplicate claim is
/// skipped and acked. A failed handler releases its claim so Stripe's retry can
/// reprocess the event later.
model ProcessedWebhookEvent {
  id          String   @id // Stripe event id, e.g. "evt_..."
  type        String
  processedAt DateTime @default(now())
}

// OCC data is opt-in, private and cascades on account deletion.
// No raw CV/JD is retained in the recommendation history.
model OccCareerProfile {
  userId       String   @id
  targetRole   String   @default("")
  location     String   @default("")
  workMode     String   @default("")
  salaryGoal   String   @default("")
  careerGoal   String   @default("")
  verifiedNotes String  @default("") @db.Text
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OccAdviceRun {
  id              String   @id @default(cuid())
  userId          String
  summary         String   @db.Text
  recommendations Json
  nextSteps       Json
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Provenance for OCC-created library versions. Enables safe undo without
/// touching the original source or unrelated documents.
model OccCvVersion {
  id              String   @id @default(cuid())
  userId          String
  sourceDocumentId String
  documentId      String   @unique
  savedUpdatedAt  DateTime
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
