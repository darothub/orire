// orire data model — Auth.js identity tables + product domain (CVs, refine
// history, subscription entitlement, monthly usage). Postgres in dev/prod.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Auth.js (next-auth) adapter models ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())

  accounts    Account[]
  sessions    Session[]
  documents   Document[]
  refineRuns  RefineRun[]
  exportEvents ExportEvent[]
  entitlement Entitlement?
  usage       UsageCounter[]
  ownedTeams      Team[]       @relation("TeamOwner")
  teamMemberships TeamMember[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Single-use, hashed tokens for the "forgot password" flow. The raw token is
// emailed to the user; only its SHA-256 hash is stored here.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Single-use, hashed tokens for email-address verification. Mirrors the reset
// flow: the raw token is emailed; only its SHA-256 hash is stored here.
model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Product domain ----------

/// A saved CV document. A user may keep several; the client tracks the active one.
model Document {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("Untitled CV")
  template  String   @default("aurora")
  data      Json
  baseline  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// History of AI refine/compare runs, kept per user (req: company history / audit).
model RefineRun {
  id             String   @id @default(cuid())
  userId         String
  documentId     String?
  company        String?
  jobDescription String   @db.Text
  provider       String
  model          String?
  resultData     Json
  ratingBefore   Int?
  ratingAfter    Int?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// One row per successful CV export (PDF). Drives the profile "exports" stat
/// so the count survives across devices (History is client-only).
model ExportEvent {
  id        String   @id @default(cuid())
  userId    String
  format    String   @default("pdf")
  template  String?
  company   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Subscription entitlement, synced from Stripe in B2. Source of truth for the plan gate.
model Entitlement {
  id                   String    @id @default(cuid())
  userId               String    @unique
  plan                 String    @default("free")
  status               String?
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  currentPeriodEnd     DateTime?
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Server-side monthly refine counter — the enforceable version of planStore usage.
model UsageCounter {
  id          String @id @default(cuid())
  userId      String
  month       String // "YYYY-MM"
  refinesUsed Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
}

/// Idempotency ledger for Stripe webhooks. Stripe delivers events at-least-once,
/// so a handler can be invoked repeatedly (and concurrently) for the same event.
/// The webhook claims each event id here before handling; a duplicate claim is
/// skipped and acked. A failed handler releases its claim so Stripe's retry can
/// reprocess the event later.
model ProcessedWebhookEvent {
  id          String   @id // Stripe event id, e.g. "evt_..."
  type        String
  processedAt DateTime @default(now())
}

// ---------- Teams / seats (Phase B3) ----------

/// A Teams/Coach workspace. Owned by a user whose personal entitlement is the
/// "teams" plan (bought via Stripe in B2). Members inherit Teams capability
/// (premium tiers without a personal key) for as long as they hold a seat.
model Team {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  plan      String   @default("teams")
  seatLimit Int      @default(5)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User         @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members TeamMember[]
  invites TeamInvite[]
  keys    TeamKey[]
  audits  TeamAudit[]

  @@index([ownerId])
}

/// A held seat on a team. A user may hold at most one seat (enforced in code).
model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  role      String   @default("member") // owner | admin | member
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@unique([userId])
  @@index([teamId])
}

/// A pending email invite. Redeemed via a single-use token embedded in a link.
model TeamInvite {
  id          String    @id @default(cuid())
  teamId      String
  email       String
  role        String    @default("member")
  token       String    @unique
  invitedById String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  acceptedAt  DateTime?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([email])
}

/// A pooled provider API key owned by a team (Phase B3b). The secret is stored
/// encrypted at rest (AES-256-GCM); ciphertext/iv/tag are never returned to the
/// client. Seated members run premium on the team's key without a personal one.
model TeamKey {
  id         String   @id @default(cuid())
  teamId     String
  provider   String // ProviderId: openai | anthropic
  ciphertext String
  iv         String
  tag        String
  label      String? // optional masked hint, e.g. "sk-…4f2a"
  createdById String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, provider])
  @@index([teamId])
}

/// An immutable audit record of a team management action (Phase B3e): renames,
/// role changes, ownership transfers, invites/revokes, joins, removals, leaves.
/// Actor/target display names are snapshotted as `detail`-adjacent strings so the
/// log still reads correctly after a member is removed or renamed. Cascade-deleted
/// with the team.
model TeamAudit {
  id         String   @id @default(cuid())
  teamId     String
  action     String // see TeamAuditAction in src/lib/team/audit.ts
  actorId    String
  actorName  String?
  targetId   String?
  targetName String?
  detail     String?
  createdAt  DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, createdAt])
}
